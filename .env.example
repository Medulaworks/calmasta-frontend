# Server-side only: never prefix these secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3006
CALMASTA_API_URL=http://127.0.0.1:3000
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=
ZITADEL_PROJECT_ID=
# Optional confidential-client credential; leave unset for a public PKCE application.
ZITADEL_CLIENT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Restricted DML role, same database as the API; never migration/owner credentials.
DATABASE_URL=
