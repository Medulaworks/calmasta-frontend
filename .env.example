# Notes
# Server-side only: never prefix these secrets with NEXT_PUBLIC_.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same SESSION_SECRET on the backend BFF store. Google credentials live only on the backend.
# Render production only: true when its trusted proxy APPENDS the actual client IP to X-Forwarded-For.
# Never enable on an app directly exposed to arbitrary client-supplied forwarding headers.

# Authentication
AUTH_TRUST_PROXY=false
SESSION_SECRET=

# Frontend
APP_URL=http://localhost:3006
CALMASTA_API_URL=http://127.0.0.1:3000

# Staff area preview: set to 1 to open /dashboard/admin with SAMPLE data and no staff check. Development only: it is ignored
# in production builds and nothing is sent to the API while it is on. Leave unset normally.
# NEXT_PUBLIC_ADMIN_PREVIEW=1
